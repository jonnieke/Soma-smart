# Public browser configuration only. Never place provider, admin, or service-role
# secrets in a VITE_* variable because Vite embeds them in the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_GA_MEASUREMENT_ID=

# Launch defaults: core journeys on, unvalidated/advanced surfaces off.
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_MARKETPLACE_PURCHASES=true
VITE_ENABLE_PAPER_STUDIO=true
VITE_ENABLE_PAPER_BANK=true
VITE_ENABLE_TEACHER_CLASSES=true
VITE_ENABLE_LISTEN_AND_LEARN=true
VITE_ENABLE_TALK_AND_LEARN=true
VITE_ENABLE_NOTEBOOK=true
VITE_ENABLE_TUTORING=false
VITE_ENABLE_EXAM_ROOMS=false
VITE_ENABLE_CAMPUS=false
VITE_ENABLE_SCHOOL_WORKSPACE=false
VITE_ENABLE_ASSESSMENT_DELIVERY=false
VITE_ENABLE_EDUCATION_INTELLIGENCE=false
VITE_ENABLE_CONTENT_OS=false
VITE_ENABLE_SCHOOL_OS=false
VITE_ENABLE_GROWTH_OS=false
VITE_ENABLE_PLATFORM_RELIABILITY=false
VITE_ENABLE_STRATEGIC_INTELLIGENCE=false
VITE_ENABLE_DEVELOPER_PORTAL=false
VITE_ENABLE_PUBLIC_STATUS_PAGE=false
